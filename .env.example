# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# PostgreSQL (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=latex_collab
DB_PASSWORD=change-me
DB_NAME=latex_collab

# JWT: generate each with `openssl rand -base64 48` (min 32 chars, must differ)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP (for local dev run MailHog: host localhost, port 1025, no auth)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="LaTeX Collab <no-reply@latex-collab.local>"

# AI assistant. LLM_PROVIDER: anthropic | openai | gemini
# Leave LLM_API_KEY empty to disable AI. LLM_MODEL is required for openai and gemini
# (anthropic defaults to claude-opus-5-5). LLM_BASE_URL is optional (proxy / OpenAI-compatible server).
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
# LLM_BASE_URL=
