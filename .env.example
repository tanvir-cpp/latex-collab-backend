# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# PostgreSQL (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=latex_collab
DB_PASSWORD=change-me
DB_NAME=latex_collab

# JWT: generate with `openssl rand -base64 48` (min 32 chars)
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP (for local dev run MailHog: host localhost, port 1025, no auth)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="LaTeX Collab <no-reply@latex-collab.local>"

# LLM provider for the AI assistant (leave the key empty to disable AI)
LLM_API_KEY=
LLM_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-sonnet-5-5
